<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>mgshadercache</AssemblyName>
    <RootNamespace>MonoGame.ShaderCache</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../MonoGame.Framework.Content.Pipeline/MonoGame.Framework.Content.Pipeline.csproj" />
    <ProjectReference Include="../../MonoGame.Framework/MonoGame.Framework.DesktopGL.csproj" />
    <Content Include="../../Artifacts/native/mgmetalcompiler/macosx/Release/mgmetalcompiler"
      Condition="Exists('../../Artifacts/native/mgmetalcompiler/macosx/Release/mgmetalcompiler')"
      Link="mgmetalcompiler"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>